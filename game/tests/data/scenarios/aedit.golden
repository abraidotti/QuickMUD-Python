out b "age            builder        commands       create         filename       \n\rname           reset          security       show           vnum           \n\rlvnum          uvnum          credits        ?              version        \n\r\n\r<100hp 100m 100mv> \xff\xf9"
rng 51895 7f5599b5
step 19 "?"
out b "Syntax:  ? [command]\n\r\n\r[command]  [description]\n\rArea       -Area attributes.\n\rRoom       -Room attributes.\n\rSector     -Sector types, terrain.\n\rExit       -Exit types.\n\rType       -Types of objects.\n\rExtra      -Object attributes.\n\rWear       -Where to wear object.\n\rSpec       -Available special programs.\n\rSex        -Sexes.\n\rAct        -Mobile attributes.\n\rAffect     -Mobile affects.\n\rWear-loc   -Where mobile wears object.\n\rSpells     -Names of current spells.\n\rContainer  -Container status.\n\rArmor      -Ac for different attacks.\n\rApply      -Apply flags\n\rForm       -Mobile body form.\n\rPart       -Mobile body parts.\n\rImm        -Mobile immunity.\n\rRes        -Mobile resistance.\n\rVuln       -Mobile vulnerability.\n\rOff        -Mobile offensive behaviour.\n\rSize       -Mobile size.\n\rPosition   -Mobile positions.\n\rWclass     -Weapon class.\n\rWtype      -Special weapon type.\n\rPortal     -Portal types.\n\rFurniture  -Furniture types.\n\rLiquid     -Liquid types.\n\rApptype    -Apply types.\n\rWeapon     -Weapon types.\n\rMprog      -MobProgram flags.\n\r\n\r<100hp 100m 100mv> \xff\xf9"
rng 51895 7f5599b5
step 20 "? sector"
out b "inside             city               field              forest             \n\rhills              mountain           swim               noswim             \n\runused             air                desert             \n\r\n\r<100hp 100m 100mv> \xff\xf9"
rng 51895 7f5599b5
step 21 "? spec"
out b "Preceed special functions with 'spec_'\n\r\n\rbreath_any         breath_acid        breath_fire        breath_frost       \n\rbreath_gas         breath_lightning   cast_adept         cast_cleric        \n\rcast_judge         cast_mage          cast_undead        executioner        \n\rfido               guard              janitor            mayor              \n\rpoison             thief              nasty              troll_member       \n\rogre_member        patrolman          \n\r\n\r<100hp 100m 100mv> \xff\xf9"
rng 51895 7f5599b5
