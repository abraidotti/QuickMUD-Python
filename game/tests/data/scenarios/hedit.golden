out b "  0. OLC EDIT         1. ALIST            2. AEDIT            3. REDIT         \n\r  4. EXIT             5. OEDIT            6. MEDIT            7. HITDICE       \n\r  8. MANADICE         9. DAMDICE         10. RESETS          11. MOB_AC        \n\r 12. ITEM_LIGHT      13. ITEM_STAFF_WAN  14. ITEM_SCROLL_PO  15. ITEM_ARMOR    \n\r 16. ITEM_WEAPON     17. WEAPON_DICE     18. ITEM_CONTAINER  19. ITEM_DRINK    \n\r 20. ITEM_FOOD       21. ITEM_MONEY      22. QMCONFIG QM     23. COLOUR COLOR A\n\r 24. COLOUR2 COLOR2  25. DIKU            26. GOLD SILVER MO  27. BRIEF COMPACT \n\r 28. DEAF            29. AFK             30. PROMPT          31. SUMMARY       \n\r 32. DEATH           33. EXPERIENCE LEV  34. PET PETS        35. TICK          \n\r 36. !               37. NORTH SOUTH EA  38. CAST            39. EXITS         \n\r 40. DROP GET GIVE   41. EQUIPMENT INVE  42. COMPARE         43. FLEE          \n\r 44. EXAMINE LOOK    45. ORDER           46. REST SLEEP STA  47. GTELL ; REPLY \n\r 48. NOTE 'NOTE WRI  49. GOSSIP CGOSSIP  50. EMOTE PMOTE PO  51. SMOTE         \n\r 52. HOLD REMOVE WE  53. BUG TYPO        54. CREDITS         55. AREAS COMMANDS\n\r 56. WHO             57. WHOIS           58. WHERE           59. HELP          \n\r 60. DESCRIPTION DE  61. PASSWORD        62. TITLE           63. WIMPY         \n\r 64. OPEN CLOSE LOC  65. DRINK EAT FILL  66. BUY LIST SELL   67. SACRIFICE     \n\r 68. SCROLL          69. BRANDISH QUAFF  70. CONSIDER        71. FOLLOW GROUP  \n\r 72. VISIBLE         73. QUIT RENT SAVE  74. RECALL /        75. SPLIT         \n\r 76. STEAL           77. PRACTICE        78. TRAIN           79. ADVANCE       \n\r 80. TRUST           81. ALLOW BAN PERM  82. REBOOT SHUTDOW  83. WIZLOCK NEWLOC\n\r 84. DENY            85. DISCONNECT      86. FREEZE          87. FORCE         \n\r 88. SOCKETS         89. LOAD            90. SET             91. STRING        \n\r 92. NOCHANNEL NOEM  93. PARDON          94. PURGE           95. RESTORE       \n\r 96. SLAY            97. TRANSFER TELEP  98. AT              99. ECHO GECHO PEC\n\r100. GOTO           101. HOLYLIGHT INVI 102. INCOGNITO      103. MEMORY        \n\r104. VNUM           105. STAT           106. MWHERE         107. PEACE         \n\r108. POOFIN POOFOUT 109. PROTECT        110. LOG SNOOP      111. SWITCH RETURN \n\r112. IMMTALK :      113. WIZNET         114. WIZHELP        115. ARMOR         \n\r116. BLESS          117. BLINDNESS      118. 'ACID BLAST' ' 119. 'CALL LIGHTNIN\n\r120. 'CAUSE LIGHT'  121. 'CHANGE SEX'   122. 'CHARM PERSON' 123. 'CHILL TOUCH' \n\r124. 'CONTINUAL LIG 125. 'CONTROL WEATH 126. 'CREATE FOOD'  127. 'CREATE SPRING\n\r128. 'CREATE WATER' 129. 'CURE BLINDNES 130. 'CURE POISON'  131. 'CURE LIGHT' '\n\r132. CURSE          133. 'DETECT EVIL'  134. 'DETECT HIDDEN 135. 'DETECT INVIS'\n\r136. 'DETECT MAGIC' 137. 'DETECT POISON 138. 'DISPEL EVIL'  139. 'DISPEL MAGIC'\n\r140. EARTHQUAKE     141. 'ENCHANT WEAPO 142. 'ENCHANT ARMOR 143. 'ENERGY DRAIN'\n\r144. 'FAERIE FIRE'  145. 'FAERIE FOG'   146. FLAMESTRIKE    147. FLY           \n\r148. IDENTIFY       149. INFRAVISION    150. INVIS 'MASS IN 151. 'KNOW ALIGNMEN\n\r152. 'LOCATE OBJECT 153. 'PASS DOOR'    154. POISON         155. SANCTUARY     \n\r156. REFRESH        157. 'REMOVE CURSE' 158. SHIELD 'STONE  159. SLEEP         \n\r160. SUMMON         161. TELEPORT       162. VENTRILOQUATE  163. WEAKEN        \n\r164. 'WORD OF RECAL 165. 'ACID BREATH'  166. NEWBIE INFO    167. LAG           \n\r168. WIZLIST        169. ROM            170. IMMORTAL IMMOR 171. SOCIALS       \n\r172. MERC           173. MAP MAPS       174. GREETING       175. MOTD          \n\r176. IMOTD          177. JOBS           178. PKILL PKILLING 179. COMMANDMENTS L\n\r180. RULES          181. SUICIDE DELETE 182. HEALER         183. GAIN          \n\r184. CLONE          185. SKILLS SPELLS  186. OUTFIT         187. AUTO AUTOLIST \n\r188. CLAN           189. PRICES PRICE   190. COUNT          191. GATE          \n\r192. AFFECTS AFFECT 193. 'RACE HELP' 'R 194. DWARF DWARVES  195. ELF ELVES     \n\r196. HUMAN HUMANS M 197. GIANT GIANTS   198. WANDS STAVES S 199. 'GROUP HEADER'\n\r200. 'GROUP HELP'   201. 'MENU CHOICE'  202. 'GROUPS' 'INFO 203. BASICS 'ROM BA\n\r204. MAGE 'MAGIC-US 205. CLERIC 'CLERIC 206. THIEF 'THIEF B 207. WARRIOR 'WARRI\n\r208. EXOTIC WEAPONS 209. 'SHIELD BLOCK' 210. ATTACK         211. BEGUILING     \n\r212. BENEDICTIONS   213. COMBAT         214. CREATION       215. CURATIVE      \n\r216. DETECTION      217. DRACONIAN      218. ENCHANTMENT    219. ENHANCEMENT   \n\r220. HARMFUL        221. HEALING        222. ILLUSION       223. MALADICTIONS  \n\r224. PROTECTIVE     225. TRANSPORTATION 226. WEATHER        227. BACKSTAB      \n\r228. BASH           229. BERSERK        230. DIRT 'DIRT KIC 231. DISARM        \n\r232. DODGE          233. 'ENHANCED DAMA 234. ENVENOM        235. 'HAND TO HAND'\n\r236. KICK           237. PARRY          238. RESCUE         239. TRIP          \n\r240. 'SECOND ATTACK 241. 'THIRD ATTACK' 242. HIDE SNEAK     243. 'FAST HEALING'\n\r244. LORE           245. HAGGLE HAGGLIN 246. PEEK           247. PICK 'PICK LOC\n\r248. MEDITATION     249. STEAL          250. 'DETECT GOOD'  251. 'DISPEL GOOD' \n\r252. 'RECHARGE'     253. 'DEMONFIRE'    254. 'RAY OF TRUTH' 255. 'PORTAL'      \n\r256. 'NEXUS'        257. 'HEAT METAL'   258. 'HOLY WORD'    259. FRENZY        \n\r260. CALM           261. HASTE          262. SLOW           263. PLAGUE        \n\r264. 'CREATE ROSE'  265. 'PROTECTION GO 266. 'GIANT STRENGT 267. 'CHAIN LIGHTNI\n\r268. FARSIGHT       269. MASS HEALING   270. 'FLOATING DISC 271. FIREPROOF     \n\r272. ALIAS UNALIAS  273. OLCSAVE        \n\r\n\r<100hp 100m 100mv> \xff\xf9"
