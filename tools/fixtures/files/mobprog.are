#MOBPROGS
#30000
* greet: who has come in
if ispc $n
  say Welcome, $n. I'll announce you as $N.
  if level $n >= 51
    say Make way for a hero!
  else
    if level $n > 50
      say Unreachable.
    else
      say Make way for $n, of level less than 51.
    endif
  endif
  if isimmort $n
    bow $n
  endif
endif
~
#30001
* speech "check": every if-check on whoever spoke, and on the herald
if rand 50
  say rand: yes
else
  say rand: no
endif
if mobhere doorman
  say mobhere doorman: yes
else
  say mobhere doorman: no
endif
if mobhere 30001
