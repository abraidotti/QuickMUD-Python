#30002
* speech "codes": every $-code, then a break inside an if
say i=$i I=$I n=$n N=$N t=$t T=$T q=$q Q=$Q
say j=$j e=$e E=$E X=$X k=$k m=$m M=$M Y=$Y l=$l s=$s S=$S Z=$Z
say o=$o O=$O p=$p P=$P J=$J
say r=$r K=$K L=$L
say R=$R
say bad=$w
if ispc $n
  say before the break
  break
endif
say not reached
~
#30003
* act "smiles"
emote smiles back at $n.
~
#30004
* give "all": what was given
if objtype $o light
  say A light! $O, with $o for a name.
else
  say Thanks for $O.
endif
if objval2 $o > 100
  say Its third value is over 100.
endif
if vnum $o == 3716
  say That's object 3716.
endif
if name $o banner
  say It's a banner.
endif
if isvisible $o
  say I can see it.
endif
~
#30005
* bribe "10": ten silver or more
say Thank you for the money, $n.
smile $n
~
#30006
* exit north (0): the doorman stops whoever he can see
say You shall not pass north, $n!
~
#30007
* exall east (1): everyone, busy or not, whether or not there's a way east
say Not east, $n.
~
#30008
* grall: everyone who comes in
nod $n
~
#30009
* give 3001: a bottle of beer, by vnum
say A beer! Thank you, $n.
~
#30010
* fight
say Take that, $n!
~
#30011
